{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev", "--", "--host", "127.0.0.1"],
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "frontend-5174",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev", "--", "--host", "127.0.0.1", "--port", "5174", "--strictPort"],
      "port": 5174
    },
    {
      "name": "backend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "backend", "run", "start"],
      "port": 4000,
      "env": { "FRONTEND_URLS": "http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174" }
    },
    {
      "name": "frontend-prod",
      "runtimeExecutable": "node",
      "runtimeArgs": ["frontend/server.js"],
      "port": 3000,
      "env": { "PORT": "3000", "BACKEND_URL": "http://127.0.0.1:4000" }
    },
    {
      "name": "graphify",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "8765", "--bind", "127.0.0.1", "--directory", "graphify-out"],
      "port": 8765
    }
  ]
}
