+.dashboard-workspace .dw-list .app-icon {
+  width: 16px;
+  height: 16px;
+  color: var(--dw-muted);
+}
+
+.dashboard-workspace .dw-list button.is-critical > .app-icon:first-child {
+  color: var(--dw-red);
+}
+
+.dashboard-workspace .dw-list button.is-warning > .app-icon:first-child {
+  color: var(--dw-gold);
+}
+
+.dashboard-workspace .dw-list button.is-info > .app-icon:first-child {
+  color: var(--dw-blue);
+}
+
+/* ---------- Pie de panel ---------- */
+
+.dashboard-workspace .dw-panel-foot {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 0.6rem;
+  padding-top: 0.7rem;
+  border-top: 1px solid var(--dw-line-soft);
+}
+
+.dashboard-workspace .dw-button-secondary {
+  display: inline-flex;
+  align-items: center;
+  gap: 0.4rem;
+  padding: 0.42rem 0.65rem;
+  border: 1px solid var(--dw-line);
+  border-radius: 8px;
+  background: var(--dw-surface);
+  box-shadow: none;
+  color: var(--dw-blue);
+  font-size: 12.5px;
+  font-weight: 600;
+  transition: border-color 0.16s ease, background 0.16s ease;
+}
+
+.dashboard-workspace .dw-button-secondary:hover:not(:disabled) {
+  border-color: var(--dw-blue);
+  background: var(--dw-tint);
+}
+
+.dashboard-workspace .dw-button-secondary:disabled {
+  cursor: not-allowed;
+  opacity: 0.5;
+}
+
+.dashboard-workspace .dw-button-secondary .app-icon {
+  width: 15px;
+  height: 15px;
+}
+
+/* styles.css aplica `button:hover:not(:disabled){box-shadow:0 6px 14px ...}`,
+   que por especificidad le gana a `box-shadow:none` puesto en una sola clase.
+   Los botones planos del tablero no deben levantarse al pasar el cursor. */
+.dashboard-workspace .dw-link:hover,
+.dashboard-workspace .dw-disclosure:hover,
+.dashboard-workspace .dw-ranking button:hover,
+.dashboard-workspace .dw-list button:hover,
+.dashboard-workspace .dw-kpi:hover {
+  box-shadow: none;
+}
+
+/* ---------- Foco visible ---------- */
+
+.dashboard-workspace button:focus-visible,
+.dashboard-workspace select:focus-visible {
+  outline: 2px solid var(--dw-blue);
+  outline-offset: 2px;
+}
+
+/* ---------- Adaptable ---------- */
+
+@media (max-width: 1100px) {
+  .dashboard-workspace .dw-grid {
+    grid-template-columns: minmax(0, 1fr);
+  }
+  .dashboard-workspace .dw-actions {
+    grid-template-columns: repeat(3, minmax(0, 1fr));
+  }
+}
+
+@media (max-width: 860px) {
+  .dashboard-workspace .dw-kpis {
+    grid-template-columns: repeat(2, minmax(0, 1fr));
+  }
+  .dashboard-workspace .dw-selection-figures {
+    grid-template-columns: repeat(3, minmax(0, 1fr));
+  }
+}
+
+@media (max-width: 620px) {
+  .dashboard-workspace .dw-actions {
+    grid-template-columns: repeat(2, minmax(0, 1fr));
+  }
+  .dashboard-workspace .dw-actions button:last-child {
+    grid-column: 1 / -1;
+  }
+  .dashboard-workspace .dw-panel-head {
+    flex-direction: column;
+    align-items: stretch;
+  }
+  .dashboard-workspace .dw-select select {
+    width: 100%;
+  }
+  .dashboard-workspace .dw-selection-figures {
+    grid-template-columns: repeat(2, minmax(0, 1fr));
+  }
+  .dashboard-workspace .dw-panel-foot {
+    flex-direction: column;
+    align-items: stretch;
+  }
+  .dashboard-workspace .dw-button-secondary {
+    justify-content: center;
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .dashboard-workspace * {
+    transition-duration: 0.01ms !important;
+    animation-duration: 0.01ms !important;
+  }
+}
